    "verify:responsive": "node scripts/verify-responsive.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:compliance": "node scripts/verify-compliance.mjs",
    "verify:member:auth-flow": "node scripts/verify-member-auth-flow.mjs",
    "verify:human-text:web": "node scripts/verify-human-text-web-gate.mjs",
    "verify:read:phase0": "node scripts/verify-read-phase0.mjs",
    "verify:read:phase0:live": "node scripts/verify-read-phase0.mjs --live",
    "verify:read:book-publish-gate": "node scripts/verify-read-book-publish-gate.mjs",
    "verify:no-protected-books-in-git": "node scripts/verify-no-protected-books-in-git.mjs",
