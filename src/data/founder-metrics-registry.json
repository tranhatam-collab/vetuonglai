        "analytics",
        "journey"
      ],
      "nullStateVi": "Chờ dữ liệu rơi",
      "nullStateEn": "Awaiting drop-rate data"
    },
    {
      "key": "error_rate",
      "blockKey": "reliability",
      "labelVi": "Tỉ lệ lỗi",
      "labelEn": "Error Rate",
      "format": "percentage",
      "formula": "errors / requests",
      "sourceHints": [
        "logs",
        "api_metrics"
      ],
      "thresholds": {
        "good": {
          "lt": 0.01
        },
        "warning": {
          "lt": 0.03
        },
        "critical": {
          "gte": 0.03
        }
      },
      "nullStateVi": "Chờ dữ liệu reliability",
      "nullStateEn": "Awaiting reliability data"
    },
    {
      "key": "p0_incidents",
      "blockKey": "reliability",
      "labelVi": "Incident P0",
      "labelEn": "P0 Incidents",
      "format": "count",
      "formula": "count(system_incidents where severity = P0 and status != resolved)",
      "sourceHints": [
        "system_incidents"
      ],
      "nullStateVi": "Chờ dữ liệu P0",
