      "labelVi": "Deploy lỗi 7 ngày",
      "labelEn": "Deploy Failures 7 Days",
      "format": "count",
      "formula": "count(deployments where status = failed over 7 days)",
      "sourceHints": [
        "deployments"
      ],
      "nullStateVi": "Chờ dữ liệu deploy",
      "nullStateEn": "Awaiting deployment data"
    },
    {
      "key": "active_members",
      "blockKey": "entitlement",
      "labelVi": "Member đang hoạt động",
      "labelEn": "Active Members",
      "format": "count",
      "formula": "count(entitlements where state = active)",
      "sourceHints": [
        "entitlements",
        "member"
      ],
      "nullStateVi": "Chờ dữ liệu member",
      "nullStateEn": "Awaiting member data"
    },
    {
