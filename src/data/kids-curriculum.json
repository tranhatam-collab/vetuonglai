{
  "name": "kids-curriculum",
  "version": "2026-04-26-v1",
  "host": "kids.vetuonglai.com",
  "status": "planned",
  "audience": "children-6-to-17-and-parents",
  "childSafety": {
    "isolatedSubdomain": true,
    "primaryNav": false,
    "publicDiscovery": false,
    "rationale": "kids domain is isolated from the public ecosystem nav to protect children; access surfaces are gated and parent-mediated.",
    "noCommerceForMinors": true,
    "noAffiliateForMinors": true,
    "noLeaderboards": true,
    "noPublicProfiles": true,
    "noEarningProgram": true,
    "aiBoundary": "AI explains, suggests, and corrects only — never completes work for the child."
  },
  "philosophy": {
    "vi": "Trẻ học để hiểu mình, làm được việc, và tạo ra thứ của riêng mình — không học để giỏi hơn người khác.",
    "en": "Children learn to understand themselves, get things done, and create their own work — not to outperform others."
  },
  "goals": {
    "include": [
      "phát triển đúng nhịp",
      "học đúng cách",
      "làm được thật",
      "tạo sản phẩm nhỏ",
      "có hồ sơ tiến bộ"
    ],
    "exclude": [
      "thi cử",
      "nhồi kiến thức",
      "kiếm tiền sớm"
    ]
  },
  "stages": [
    {
      "key": "explore",
      "ageRange": "6-8",
      "labelVi": "Khám phá",
      "labelEn": "Explore",
      "objectives": ["tò mò", "quan sát", "đặt câu hỏi", "không sợ sai"],
      "tracks": [
        {
          "key": "awareness",
          "labelVi": "Nhận thức",
          "items": ["thế giới là gì", "câu hỏi là gì", "tại sao"]
        },
        {
          "key": "language",
          "labelVi": "Ngôn ngữ",
          "items": ["kể chuyện", "viết câu ngắn", "nói rõ"]
        },
        {
          "key": "creativity",
          "labelVi": "Sáng tạo",
          "items": ["vẽ", "làm thủ công", "kể chuyện bằng hình"]
        },
        {
          "key": "rhythm",
          "labelVi": "Nhịp sống",
          "items": ["ngủ", "ăn", "chơi", "học nhẹ"]
        }
      ],
      "projects": ["vẽ 1 câu chuyện", "kể 1 câu chuyện", "làm 1 sản phẩm đơn giản"],
      "outputs": ["1 bài vẽ", "1 câu chuyện", "1 sản phẩm nhỏ"]
    },
    {
      "key": "create",
      "ageRange": "9-12",
      "labelVi": "Sáng tạo",
      "labelEn": "Create",
      "objectives": ["bắt đầu tạo", "diễn đạt ý tưởng", "hiểu quy trình đơn giản"],
