    "requiredFieldsByStep": {
      "step_1_qualification": [
        "business_company_name",
        "business_registration_number",
        "business_country_of_registration",
        "business_email",
        "business_phone",
        "business_representative_name",
        "business_representative_title",
        "business_authorization_confirmed"
      ],
      "step_2_need_survey": [
        "business_company_size_band",
        "business_industry",
        "business_priority_areas",
        "business_primary_problem_statement",
        "business_needed_support_type"
      ],
      "step_3_verification": [
        "business_registration_document_upload",
        "business_linkedin_url",
        "business_reference_links"
      ],
      "step_4_recommendation": [
        "recommended_packages",
        "comparison_bundle_ids",
        "demo_preview_ids",
        "output_bundle_ids",
        "next_step_action"
      ]
    }
  },
  "packageRecommendationRules": {
    "allowedPackageFamilyKey": "business_packages_v1",
    "minimumRecommendationCount": 2,
    "maximumRecommendationCount": 3,
    "businessLayerRequires": [
      "company_registration_verified",
      "primary_problem_statement",
      "operations_owner_available"
    ],
    "sizeBandRules": [
      {
        "if": "under_10",
        "recommend": [
          "business_entry",
          "business_foundation"
        ]
      },
      {
        "if": "10_50",
        "recommend": [
          "business_foundation",
          "business_applied"
        ]
      },
      {
        "if": "51_200_or_gt_200",
        "recommend": [
          "business_applied",
          "business_strategic"
        ]
      }
    ],
    "supportTypeInfluence": [
      {
        "signal": "overall_assessment",
        "promote": "business_entry"
      },
      {
        "signal": "internal_training",
        "promote": "business_foundation"
      },
      {
        "signal": "pilot_operation",
        "promote": "business_applied"
      },
      {
        "signal": "long_term_solution",
        "promote": "business_strategic"
      }
    ],
    "fallbackPackageKeys": [
      "business_entry",
      "business_foundation"
    ]
  },
