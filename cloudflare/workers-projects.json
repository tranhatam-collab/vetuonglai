{
  "accountId": "62d57eaa548617aeecac766e5a1cb98e",
  "compatibilityDate": "2026-03-23",
  "workers": [
    {
      "key": "home",
      "scriptName": "vetuonglai-home",
      "entry": "workers/generic-worker.mjs",
      "assetsDir": "dist/vetuonglai.com",
      "routes": ["vetuonglai.com/*", "www.vetuonglai.com/*"],
      "accessRuntime": {
        "requiredSecrets": [
          "SESSION_COOKIE_SECRET",
          "MAGIC_LINK_SIGNING_KEY",
          "PAY_IAI_ONE_API_KEY",
          "PAY_IAI_ONE_WEBHOOK_SECRET"
        ],
        "recommendedVars": [
          "VTL_ENV",
          "PAY_IAI_ONE_BASE_URL",
          "PAY_IAI_ONE_TIMEOUT_MS",
          "PAYPAL_ENVIRONMENT",
          "PAYPAL_WEBHOOK_VERIFY_MODE",
          "STRIPE_WEBHOOK_VERIFY_MODE",
          "STRIPE_WEBHOOK_TOLERANCE_SECONDS",
          "PAYPAL_ANNUAL_ACCESS_CHECKOUT_URL",
          "PAYPAL_PACK_CHECKOUT_URLS_JSON",
          "STRIPE_ANNUAL_ACCESS_CHECKOUT_URL",
          "STRIPE_PACK_CHECKOUT_URLS_JSON",
          "VTL_ALLOWED_RETURN_HOSTS"
        ],
        "optionalBindings": [
          "ACCESS_KV_NAMESPACE"
        ]
      }
    },
    {
      "key": "vc",
      "scriptName": "vetuonglai-vc",
